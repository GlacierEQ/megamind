{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SovereignAgent",
  "type": "object",
  "required": ["agent_id", "name", "role", "pistons"],
  "properties": {
    "agent_id": {
      "type": "string",
      "description": "Unique identifier for the sovereign agent"
    },
    "name": {
      "type": "string",
      "description": "Display name of the agent"
    },
    "role": {
      "type": "string",
      "description": "Primary operational role"
    },
    "model_preference": {
      "type": "string",
      "default": "gemini-3.6-flash-high"
    },
    "pistons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of 12 Pistons assigned to this agent"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
