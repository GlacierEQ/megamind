{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PistonDefinition",
  "type": "object",
  "required": ["piston_id", "tier", "capability", "stealth_factor"],
  "properties": {
    "piston_id": {
      "type": "string",
      "enum": [
        "MICROWAVE", "SUPERNOVA", "CORE-THINK", "BODYBUILDER",
        "SHERLOCK-ALPHA", "SONIC", "GHOST", "PHANTOM",
        "VIPER", "WRAITH", "SPECTER", "SHADOW"
      ]
    },
    "tier": {
      "type": "string",
      "enum": ["Tier-0: APEX CLASSIFIED", "Tier-1: BLACK OPS", "Tier-2: TACTICAL GREY"]
    },
    "capability": {
      "type": "string",
      "description": "Functional specialization"
    },
    "stealth_factor": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  }
}
