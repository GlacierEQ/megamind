{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TechnologyMap",
  "type": "object",
  "required": ["version", "domains", "active_exhibits"],
  "properties": {
    "version": {
      "type": "string"
    },
    "domains": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "language": { "type": "string" },
          "toolchain": { "type": "string" },
          "piston_owner": { "type": "string" }
        }
      }
    },
    "active_exhibits": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
